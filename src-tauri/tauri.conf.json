{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知行 StudyFlow",
  "version": "0.2.0",
  "identifier": "app.studyflow.zxing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "知行 StudyFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "把终点变成今天的一小步",
    "longDescription": "知行 StudyFlow：本地离线的学习目标管理。今日建议量、连续打卡与每周弹性休息日、近 7 天速度推算、周报复盘。数据保存在本机 SQLite，无账号、无云端。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
